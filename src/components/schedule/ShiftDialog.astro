---
/**
 * The one "Set hours" dialog shared by every roster row in the edit form.
 *
 * Pick a start and end time, tick the days they apply to, and apply — or mark
 * the ticked days off. Behaviour lives in the page script; this is markup only.
 *
 * Its controls deliberately have no `name`: the dialog sits inside the edit
 * form, and nothing in it should be submitted. It writes into each row's
 * hidden inputs instead.
 */
import Button from '../primitives/Button.astro';
import Icon from '../primitives/Icon.astro';
import { DAYS, DAY_LABELS, formatShort, type Day } from '../../lib/schedule';
import { inputClass, errorText, removeNewRowClass } from './classes';

interface Props {
  dates: Record<Day, string>;
  dayOffDates: Set<string>;
}

const { dates, dayOffDates } = Astro.props;

const quickDays = [
  { key: 'weekdays', label: 'Weekdays' },
  { key: 'weekend', label: 'Weekend' },
  { key: 'all', label: 'All' },
  { key: 'none', label: 'None' },
];

const chip =
  'rounded-full border border-(--border-strong) px-3 py-1 text-xs font-semibold text-(--text-body) hover:border-(--accent) hover:text-(--accent)';
---

<dialog
  id="shift-dialog"
  aria-labelledby="shift-dialog-title"
  class="m-auto max-h-[calc(100dvh-2rem)] w-[min(36rem,calc(100vw-2rem))] overflow-y-auto rounded-(--radius-card) border border-(--border-subtle) bg-(--surface-raised) p-0 text-(--text-body) shadow-(--shadow-card-hover) backdrop:bg-black/55 backdrop:backdrop-blur-sm"
>
  <div class="flex flex-col gap-6 p-6 sm:p-7">
    <div class="flex items-start justify-between gap-4">
      <div>
        <p class="text-xs font-semibold tracking-wide uppercase text-(--accent)">Set hours</p>
        <h2 id="shift-dialog-title" class="text-xl font-bold text-(--text-strong)" data-dialog-name>Employee</h2>
      </div>
      <button type="button" data-dialog-close aria-label="Close" class={removeNewRowClass}>
        <Icon name="close" size={18} />
      </button>
    </div>

    <fieldset class="flex flex-col gap-3">
      <legend class="mb-3 text-sm font-semibold text-(--text-strong)">Hours</legend>
      <div class="grid grid-cols-2 gap-4">
        <label class="flex flex-col gap-1.5 text-sm font-medium text-(--text-body)">
          Start time
          <input type="time" data-dialog-start class:list={[inputClass, 'text-base']} />
        </label>
        <label class="flex flex-col gap-1.5 text-sm font-medium text-(--text-body)">
          End time
          <input type="time" data-dialog-end class:list={[inputClass, 'text-base']} />
        </label>
      </div>
      <div class="flex flex-wrap items-center gap-1.5" data-dialog-presets hidden>
        <span class="mr-1 text-xs text-(--text-muted)">Used this week:</span>
      </div>
    </fieldset>

    <fieldset class="flex flex-col gap-3">
      <legend class="mb-3 text-sm font-semibold text-(--text-strong)">Days</legend>
      <div class="flex flex-wrap gap-1.5">
        {quickDays.map((q) => (
          <button type="button" data-select-days={q.key} class={chip}>{q.label}</button>
        ))}
      </div>
      <div class="grid grid-cols-4 gap-2 sm:grid-cols-7">
        {
          DAYS.map((day) => (
            <label class="flex cursor-pointer flex-col items-center gap-0.5 rounded-lg border border-(--border-strong) px-1 py-2 text-center text-(--text-body) transition-colors select-none hover:border-(--accent) has-checked:border-(--accent) has-checked:bg-(--accent) has-checked:text-(--accent-on) has-focus-visible:outline-2 has-focus-visible:outline-offset-2 has-focus-visible:outline-(--focus-ring)">
              <input type="checkbox" value={day} data-dialog-day class="sr-only" />
              <span class="text-sm font-bold">{DAY_LABELS[day]}</span>
              <span class="text-[0.7rem] opacity-80">{formatShort(dates[day])}</span>
              {dayOffDates.has(dates[day]) && (
                <span class="text-[0.6rem] font-semibold tracking-wide uppercase">Holiday</span>
              )}
            </label>
          ))
        }
      </div>
    </fieldset>

    <p role="alert" class={errorText} data-dialog-error hidden></p>

    <div class="flex flex-wrap items-center gap-3 border-t border-(--border-subtle) pt-5">
      <Button type="button" data-dialog-apply>
        <Icon name="check" size={16} />
        Apply to selected days
      </Button>
      <Button type="button" variant="secondary" data-dialog-off>Mark selected days off</Button>
      <Button type="button" variant="ghost" data-dialog-close>Cancel</Button>
    </div>
  </div>
</dialog>
