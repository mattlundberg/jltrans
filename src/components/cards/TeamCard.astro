---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Card from '../primitives/Card.astro';
import { initials } from '../../lib/format';

/**
 * A team member: the photo leads, with name, title and location beneath.
 * Surface comes from Card; this adds only the portrait and meta.
 */
interface Props {
  name: string;
  role: string;
  location?: string;
  /** Headshot from the content collection. Falls back to initials when absent. */
  photo?: ImageMetadata;
}

const { name, role, location, photo } = Astro.props;

const portrait = 'aspect-square w-full rounded-[calc(var(--radius-card)-0.5rem)]';
---

<Card as="li" tone="raised" class="gap-5">
  {
    photo ? (
      <Image
        src={photo}
        alt={name}
        widths={[320, 480, 640, 800]}
        sizes="(min-width: 640px) 22rem, calc(100vw - 5.5rem)"
        loading="lazy"
        class:list={[portrait, 'object-cover']}
      />
    ) : (
      <span
        class:list={[
          portrait,
          'flex items-center justify-center bg-(--accent-subtle-bg) text-5xl font-bold text-(--accent-subtle-text)',
        ]}
        aria-hidden="true"
      >
        {initials(name)}
      </span>
    )
  }
  <div class="flex flex-col gap-1 text-center">
    <h3 class="text-xl leading-tight font-bold text-(--text-strong)">{name}</h3>
    <p class="text-sm font-semibold text-(--accent)">{role}</p>
    {location && <p class="text-xs tracking-wide uppercase text-(--text-muted)">{location}</p>}
  </div>
</Card>
