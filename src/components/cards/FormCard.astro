---
import Card from '../primitives/Card.astro';
import Icon from '../primitives/Icon.astro';

/**
 * An application form, offered as a fillable PDF.
 *
 * `href` is null for a form whose file is not ready yet, so this renders an
 * explicit "coming soon" state rather than a dead link. A card that looks
 * clickable and does nothing is worse than one that says so.
 */
interface Props {
  title: string;
  description: string;
  href: string | null;
  /** Page count, shown so applicants know what they are downloading. */
  pages?: number;
  audience: string;
}

const { title, description, href, pages, audience } = Astro.props;
const available = href !== null;
---

<Card as="li" tone="raised" interactive={available} class="gap-3">
  <div class="flex items-start justify-between gap-3">
    <h3 class="text-lg leading-tight font-bold text-(--text-strong)">
      {
        available ? (
          // Opens in a new tab: browsers show the PDF there, and filling it in
          // should not cost the applicant their place on this page.
          <a
            href={href}
            target="_blank"
            rel="noopener"
            class="after:absolute after:inset-0 after:content-['']"
          >
            {title}
            <span class="sr-only"> (PDF, opens in a new tab)</span>
          </a>
        ) : (
          title
        )
      }
    </h3>
    {
      available ? (
        <Icon
          name="download"
          size={18}
          class="mt-1 shrink-0 text-(--accent) transition-transform group-hover:translate-y-0.5"
        />
      ) : (
        <span class="mt-0.5 shrink-0 rounded-full bg-(--surface-sunken) px-2.5 py-1 text-[0.65rem] font-semibold tracking-wide uppercase text-(--text-muted)">
          Soon
        </span>
      )
    }
  </div>

  <p class="text-sm leading-relaxed text-(--text-body)">{description}</p>

  {
    !available && (
      <p class="mt-1 text-xs leading-relaxed text-(--text-muted)">
        This form is being prepared. In the meantime, call us and we will send it to you directly.
      </p>
    )
  }

  <p class="mt-auto flex flex-wrap gap-x-3 gap-y-1 pt-2 text-[0.65rem] font-semibold tracking-[0.1em] uppercase text-(--text-muted)">
    {available && <span class="text-(--accent)">Fillable PDF{pages ? ` · ${pages} ${pages === 1 ? 'page' : 'pages'}` : ''}</span>}
    <span>For {audience}</span>
  </p>
</Card>
