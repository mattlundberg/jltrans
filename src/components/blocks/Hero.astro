---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import HeroBackdrop from './HeroBackdrop.astro';
import Container from '../primitives/Container.astro';
import Button from '../primitives/Button.astro';
import Icon from '../primitives/Icon.astro';
import { site } from '../../data/site';
import { telHref } from '../../lib/format';

/**
 * Home page hero.
 *
 * With `backgroundImage`, the photo fills the section under a dark gradient
 * that is heaviest on the left, where the headline sits, so white type stays
 * legible over a bright sky. Without one it falls back to the brand backdrop
 * that inner pages use.
 */
interface Props {
  /** A photo from src/assets, resized and served as WebP by Astro. */
  backgroundImage?: ImageMetadata;
}

const { backgroundImage } = Astro.props;
---

<section class="relative isolate overflow-hidden bg-(--color-ink-900) text-white">
  {
    backgroundImage ? (
      <div class="absolute inset-0 -z-10" aria-hidden="true">
        <Image
          src={backgroundImage}
          alt=""
          widths={[640, 960, 1280, 1920, 2560]}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
          class="absolute inset-0 h-full w-full object-cover object-[70%_center]"
        />
        {/* Small screens: the type covers the whole photo, so darken it evenly. */}
        <div class="absolute inset-0 bg-(--color-ink-950)/70 lg:hidden"></div>
        {/* Large screens: darken behind the headline, let the trucks show on the right. */}
        <div class="absolute inset-0 hidden bg-linear-to-r from-(--color-ink-950)/90 via-(--color-ink-950)/60 to-(--color-ink-950)/10 lg:block"></div>
        <div class="absolute inset-x-0 bottom-0 h-1/3 bg-linear-to-t from-(--color-ink-950)/60 to-transparent"></div>
      </div>
    ) : (
      <HeroBackdrop />
    )
  }

  <Container class="relative py-20 sm:py-28 lg:py-36">
    <div class="flex max-w-3xl flex-col gap-7">
      <p
        class="inline-flex w-fit items-center gap-2 rounded-full border border-white/20 bg-white/5 px-4 py-1.5 text-xs font-semibold tracking-[0.12em] uppercase text-white"
      >
        <span class="relative flex h-1.5 w-1.5">
          <span class="absolute inline-flex h-full w-full rounded-full bg-(--color-brand-500)"></span>
        </span>
        Intermodal &middot; Drayage &middot; Truckload
      </p>

      <h1 class="text-hero font-extrabold text-white">
        Arizona&rsquo;s premier{' '}
        <span class="text-(--color-brand-500)">intermodal</span> carrier.
      </h1>

      <p class="max-w-2xl text-lg leading-relaxed text-(--color-ink-100) sm:text-xl">
        A green fleet running 24 hours a day, seven days a week, across Arizona, Northern Nevada and
        Sonora, Mexico &mdash; with freight claims under 0.1% over the last three years.
      </p>

      <div class="flex flex-wrap items-center gap-3">
        <Button href="/contact/" size="lg">
          Get in touch
          <Icon name="arrow-right" size={18} />
        </Button>
        <Button href={`tel:${telHref(site.phone)}`} size="lg" variant="secondary" class="border-white/30 text-white hover:border-(--color-brand-400) hover:text-(--color-brand-400)">
          <Icon name="phone" size={16} />
          {site.phone}
        </Button>
      </div>
    </div>
  </Container>
</section>
