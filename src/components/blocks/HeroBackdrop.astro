---
/**
 * The brand backdrop behind the home hero and every inner-page header: a red
 * glow from the top left, a cool grey glow from the top right, and a faint
 * diagonal ruling that suggests movement without competing with the type.
 *
 * Place it inside a `relative isolate overflow-hidden` dark section; it sits
 * behind the content at `-z-10`.
 */
---

<div class="absolute inset-0 -z-10" aria-hidden="true">
  <div
    class="absolute inset-0"
    style="background:
      radial-gradient(80rem 40rem at 15% -10%, color-mix(in oklab, var(--color-brand-500) 34%, transparent), transparent 60%),
      radial-gradient(60rem 34rem at 100% 0%, color-mix(in oklab, var(--color-ink-500) 45%, transparent), transparent 65%);"
  >
  </div>
  <div
    class="absolute inset-0 opacity-[0.07]"
    style="background-image: repeating-linear-gradient(115deg, #fff 0 1px, transparent 1px 12px);"
  >
  </div>
</div>
