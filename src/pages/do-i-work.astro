---
import PageLayout from '../layouts/PageLayout.astro';
import Container from '../components/primitives/Container.astro';
import Button from '../components/primitives/Button.astro';
import Icon from '../components/primitives/Icon.astro';
import EmployeeEditRow from '../components/schedule/EmployeeEditRow.astro';
import DayOffEditRow from '../components/schedule/DayOffEditRow.astro';
import ShiftDialog from '../components/schedule/ShiftDialog.astro';
import { inputClass } from '../components/schedule/classes';
import {
  sessionCookie,
  createSessionToken,
  verifySessionToken,
  timingSafeEqual,
  checkRateLimit,
  recordFailedAttempt,
  clearAttempts,
  type Role,
} from '../lib/auth';
import { getSecrets } from '../lib/env';
import {
  DAYS,
  DAY_LABELS,
  LIMITS,
  loadSchedule,
  updateSchedule,
  parseWeekForm,
  weekEditFrom,
  applyWeekEdit,
  copyWeek,
  emptySchedule,
  getWeek,
  weekHasShifts,
  weekDates,
  currentAndNextWeek,
  todayIso,
  formatShort,
  formatLong,
  formatTimestamp,
  formatShift,
  type Schedule,
  type DayOff,
  type WeekEdit,
  type ShiftError,
} from '../lib/schedule';

/**
 * Rendered on demand, never prerendered.
 *
 * This single line is what makes the gate real. On a static build the protected
 * content would be written into dist/ and served to anyone who asked, with the
 * password form as decoration over the top. CI asserts the marker string below
 * does not appear in dist/.
 */
export const prerender = false;

const PAGE = '/do-i-work/';

const {
  password: PASSWORD,
  editorPassword: EDITOR_PASSWORD,
  authSecret: AUTH_SECRET,
} = await getSecrets();

/** Misconfiguration must fail closed, never open. */
const configured = Boolean(PASSWORD) && Boolean(AUTH_SECRET);

/**
 * Editing is enabled only by a distinct editor password. If someone sets it to
 * the staff password, every staff member would silently become an editor — so
 * that case disables editing instead.
 */
const editingEnabled = Boolean(EDITOR_PASSWORD) && EDITOR_PASSWORD !== PASSWORD;

/**
 * Rate-limit key.
 *
 * Read from headers rather than `Astro.clientAddress`, which is only defined
 * for on-demand routes and whose behaviour when unavailable is adapter-specific
 * — a throttle is not worth risking a 500 over.
 *
 * Netlify sets `x-nf-client-connection-ip` on every request. Locally there is
 * no real client IP, so all requests share the 'local' bucket — fine for a
 * throttle whose job is to blunt brute force.
 */
const clientIp =
  Astro.request.headers.get('x-nf-client-connection-ip') ??
  Astro.request.headers.get('x-forwarded-for')?.split(',')[0]?.trim() ??
  'local';

/* This route must never be indexed or cached by a shared cache. */
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');
Astro.response.headers.set('Cache-Control', 'private, no-store, max-age=0');

const { current: CURRENT_WEEK, next: NEXT_WEEK } = currentAndNextWeek();

/** `?week=next` selects next week; anything else is this week. */
const weekUrl = (weekOf: string, extra = '') =>
  `${PAGE}?week=${weekOf === NEXT_WEEK ? 'next' : 'current'}${extra}`;
const weekLabel = (weekOf: string) => (weekOf === NEXT_WEEK ? 'Next week' : 'This week');

let error: string | null = null;
let role: Role | null = null;

/** Set when a save is refused, so the editor's input is shown again rather than lost. */
let draft: WeekEdit | null = null;
let draftBasedOn: string | null = null;
let draftErrors: ShiftError[] = [];
let saveError: string | null = null;

if (configured) {
  role = await verifySessionToken(AUTH_SECRET as string, Astro.cookies.get(sessionCookie.name)?.value);

  if (Astro.request.method === 'POST') {
    const form = await Astro.request.formData();
    const intent = String(form.get('intent') ?? 'login');

    if (intent === 'save' || intent === 'copy') {
      const basedOn = String(form.get('basedOn') ?? '') || null;

      if (!role) {
        // The session expired mid-edit. The gate shows `error`, not `saveError`.
        error = 'Your session expired before the schedule was saved. Sign in and make the changes again.';
      } else if (role !== 'editor' || !editingEnabled) {
        Astro.response.status = 403;
        saveError = 'Your session does not have permission to edit. Sign in with the editor password.';
      } else if (intent === 'save') {
        const weekOf = String(form.get('weekOf') ?? '');

        if (weekOf !== CURRENT_WEEK && weekOf !== NEXT_WEEK) {
          // The form was opened before Monday rolled over, so "this week" now
          // means a different week. Saving would write to the wrong one.
          saveError = 'A new week started while you were editing, so your changes were not saved. Please make them again.';
        } else {
          const { edit, errors } = parseWeekForm(form, weekOf);

          if (errors.length) {
            Astro.response.status = 422;
            draft = edit;
            draftBasedOn = basedOn;
            draftErrors = errors;
            saveError = 'Some entries need fixing before the schedule can be saved:';
          } else {
            try {
              const result = await updateSchedule(basedOn, (current) => applyWeekEdit(current, edit));
              if (result.ok) return Astro.redirect(weekUrl(weekOf, '&saved=1'), 303);

              // Someone saved since this form was opened. Re-show this editor's
              // input against the newer stamp: saving again is then a deliberate
              // choice to replace the other changes.
              draft = edit;
              draftBasedOn = result.current.updatedAt;
              saveError = `Someone else saved the schedule${
                result.current.updatedAt ? ` at ${formatTimestamp(result.current.updatedAt)}` : ''
              } while you were editing. Your changes are below but have not been saved. Saving again will replace theirs.`;
            } catch (err) {
              console.error('do-i-work: save failed', err);
              draft = edit;
              draftBasedOn = basedOn;
              saveError = 'The schedule could not be saved. Please try again in a moment.';
            }
          }
        }
      } else {
        const from = String(form.get('from') ?? '');
        const to = String(form.get('to') ?? '');
        const valid =
          (from === CURRENT_WEEK && to === NEXT_WEEK) || (from === NEXT_WEEK && to === CURRENT_WEEK);

        if (!valid) {
          saveError = 'A new week started before the copy went through, so nothing was copied. Please try again.';
        } else {
          try {
            const result = await updateSchedule(basedOn, (current) => copyWeek(current, from, to));
            if (result.ok) return Astro.redirect(weekUrl(to, '&copied=1'), 303);
            saveError =
              'Someone else changed the schedule just before you copied, so nothing was copied. Check the weeks below and try again.';
          } catch (err) {
            console.error('do-i-work: copy failed', err);
            saveError = 'The schedule could not be copied. Please try again in a moment.';
          }
        }
      }
    } else if (!role) {
      const limit = checkRateLimit(clientIp);

      if (!limit.allowed) {
        error = `Too many attempts. Please try again in ${Math.ceil(limit.retryAfter / 60)} minutes.`;
        Astro.response.headers.set('Retry-After', String(limit.retryAfter));
      } else {
        const submitted = String(form.get('password') ?? '');

        // Both comparisons always run, so response time does not reveal which
        // password (if either) was close.
        const [isEditor, isViewer] = await Promise.all([
          editingEnabled ? timingSafeEqual(submitted, EDITOR_PASSWORD as string) : Promise.resolve(false),
          timingSafeEqual(submitted, PASSWORD as string),
        ]);
        const granted: Role | null = isEditor ? 'editor' : isViewer ? 'viewer' : null;

        if (granted) {
          Astro.cookies.set(
            sessionCookie.name,
            await createSessionToken(AUTH_SECRET as string, granted),
            sessionCookie.options
          );
          clearAttempts(clientIp);
          // Redirect so a refresh does not resubmit the password.
          return Astro.redirect(PAGE, 303);
        }

        recordFailedAttempt(clientIp);
        // Deliberately generic: revealing whether a password was "close" or
        // whether the page exists helps only an attacker.
        error = 'That password is not correct.';
      }
    }
  }
}

const authorised = role !== null;
const isEditor = role === 'editor' && editingEnabled;

/* -------------------------------------------------------------------------- */
/* Schedule data                                                              */
/* -------------------------------------------------------------------------- */

let schedule: Schedule = emptySchedule();
let storageError = false;

if (authorised) {
  try {
    schedule = await loadSchedule();
  } catch (err) {
    console.error('do-i-work: load failed', err);
    storageError = true;
  }
}

const params = Astro.url.searchParams;
const selectedWeek = draft ? draft.weekOf : params.get('week') === 'next' ? NEXT_WEEK : CURRENT_WEEK;

const editing = isEditor && !storageError && (params.has('edit') || draft !== null);
const notice = editing
  ? null
  : params.has('saved')
    ? 'Schedule saved. Staff will see these changes now.'
    : params.has('copied')
      ? `Shifts copied into ${weekLabel(selectedWeek).toLowerCase()}. Review them below and edit anything that differs.`
      : null;

/** What the edit form shows: the refused draft if there is one, else what is stored. */
const edit = draft ?? weekEditFrom(schedule, selectedWeek);
const basedOn = draft ? draftBasedOn : schedule.updatedAt;

/** Errors keyed `row-day` (or `row-name`) for display beside the field. */
const errorAt = new Map(draftErrors.map((e) => [`${e.row}-${e.day ?? 'name'}`, e.message]));
const rowLabel = (row: number) => edit.employees[row]?.name || `Row ${row + 1}`;

const today = todayIso();
const dates = weekDates(selectedWeek);
const week = getWeek(schedule, selectedWeek);
const hasShifts = weekHasShifts(schedule, selectedWeek);
const currentHasShifts = weekHasShifts(schedule, CURRENT_WEEK);
const nextHasShifts = weekHasShifts(schedule, NEXT_WEEK);

const daysOffByDate = new Map<string, DayOff>(schedule.daysOff.map((d) => [d.date, d]));
const dayOffDates = new Set(daysOffByDate.keys());
const upcomingDaysOff = schedule.daysOff.filter((d) => d.date >= today);
const currentWeekDates = Object.values(weekDates(CURRENT_WEEK));
const nextWeekDates = Object.values(weekDates(NEXT_WEEK));

/**
 * Both copy directions, offered whenever there is a roster. Copying over a week
 * that already has shifts asks first, and says so plainly when the source is
 * empty — that copy clears the target rather than filling it.
 */
const capitalise = (text: string) => text.charAt(0).toUpperCase() + text.slice(1);
const copyConfirm = (sourceHasShifts: boolean, source: string, target: string) =>
  sourceHasShifts
    ? `Replace ${target}'s shifts with ${source}'s? ${capitalise(target)}'s current shifts will be lost.`
    : `${capitalise(source)} has no shifts entered, so copying will clear ${target}'s shifts. Continue?`;

const copyActions = [
  {
    from: CURRENT_WEEK,
    to: NEXT_WEEK,
    label: 'Copy this week to next week',
    confirm: nextHasShifts ? copyConfirm(currentHasShifts, 'this week', 'next week') : '',
  },
  {
    from: NEXT_WEEK,
    to: CURRENT_WEEK,
    label: 'Copy next week to this week',
    confirm: currentHasShifts ? copyConfirm(nextHasShifts, 'next week', 'this week') : '',
  },
];

const thClass =
  'px-3 py-2.5 text-left text-xs font-semibold tracking-wide whitespace-nowrap uppercase text-(--text-muted)';
const sectionTitle = 'text-xl font-bold text-(--text-strong) sm:text-2xl';
---

<PageLayout
  title="Do I Work"
  kicker="Restricted"
  description="This page is password protected."
  lead={authorised ? 'Staff schedule for this week and next, plus company days off.' : 'This page is password protected.'}
  noindex
>
  <Container width={authorised ? (editing ? 'wide' : 'content') : 'prose'} class="py-section">
    {
      !configured ? (
        <div class="rounded-(--radius-card) border border-(--border-strong) bg-(--surface-sunken) p-6 sm:p-8">
          <h2 class="font-bold text-(--text-strong)">Not configured</h2>
          <p class="mt-2 text-sm leading-relaxed text-(--text-body)">
            This page requires the <code>DO_I_WORK_PASSWORD</code> and <code>AUTH_SECRET</code>
            {' '}environment variables (plus <code>DO_I_WORK_EDITOR_PASSWORD</code> to allow
            {' '}editing). Locally, copy <code>.env.example</code> to <code>.env</code>. In
            {' '}production, set them in the Netlify site's environment variables.
          </p>
        </div>
      ) : authorised ? (
        <div class="flex flex-col gap-10">
          {/*
            DO_I_WORK_PROTECTED_CONTENT
            ---------------------------
            The marker above is what CI greps for in dist/ to prove this block is
            not in the static bundle. Keep it here.
          */}

          {/* --- Session bar ------------------------------------------------ */}
          <div class="flex flex-col gap-4 border-b border-(--border-subtle) pb-6 sm:flex-row sm:items-center sm:justify-between">
            <div class="flex flex-wrap items-center gap-3 text-sm text-(--text-muted)">
              <span class="inline-flex items-center gap-1.5 rounded-full bg-(--accent-subtle-bg) px-3 py-1 text-xs font-semibold tracking-wide uppercase text-(--accent-subtle-text)">
                <Icon name={isEditor ? 'shield' : 'lock'} size={14} />
                {isEditor ? 'Editor' : 'Staff'}
              </span>
              {schedule.updatedAt ? (
                <span>Last updated {formatTimestamp(schedule.updatedAt)}</span>
              ) : (
                <span>Not published yet</span>
              )}
            </div>

            <form method="POST" action="/do-i-work/logout">
              <Button type="submit" variant="secondary">Sign out</Button>
            </form>
          </div>

          {notice && (
            <div role="status" class="flex items-start gap-3 rounded-(--radius-card) border-l-4 border-(--accent) bg-(--accent-subtle-bg) p-5">
              <Icon name="check" size={20} class="mt-0.5 text-(--accent)" />
              <p class="text-sm font-medium text-(--text-strong)">{notice}</p>
            </div>
          )}

          {saveError && (
            <div role="alert" class="rounded-(--radius-card) border-l-4 border-(--accent) bg-(--accent-subtle-bg) p-5">
              <p class="text-sm font-medium text-(--text-strong)">{saveError}</p>
              {draftErrors.length > 0 && (
                <ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-(--text-body)">
                  {draftErrors.map((e) => (
                    <li>
                      <a
                        href={`#${e.day ? `emp-${e.row}-${e.day}-start` : `emp-${e.row}-name`}`}
                        class="underline-offset-4 hover:underline"
                      >
                        {rowLabel(e.row)}
                        {e.day && `, ${DAY_LABELS[e.day]} ${formatShort(dates[e.day])}`}
                      </a>
                      : {e.message}
                    </li>
                  ))}
                </ul>
              )}
            </div>
          )}

          {storageError ? (
            <div role="alert" class="rounded-(--radius-card) border border-(--border-strong) bg-(--surface-sunken) p-6 sm:p-8">
              <h2 class="font-bold text-(--text-strong)">Schedule unavailable</h2>
              <p class="mt-2 text-sm leading-relaxed text-(--text-body)">
                The schedule could not be loaded right now. Please refresh in a minute, or call
                dispatch to confirm your shift.
              </p>
            </div>
          ) : editing ? (
            /* ================================================================
               EDIT MODE — one form for one week. "Add" buttons clone a
               <template> row in the browser; the Remove box drops a saved row
               on save.
               ================================================================ */
            <form method="POST" action={weekUrl(selectedWeek)} class="flex flex-col gap-10">
              <input type="hidden" name="intent" value="save" />
              <input type="hidden" name="weekOf" value={selectedWeek} />
              <input type="hidden" name="basedOn" value={basedOn ?? ''} />
              {/* The next free row index. "Add" increments it. */}
              <input type="hidden" name="emp-count" value={edit.employees.length} />
              <input type="hidden" name="off-count" value={edit.daysOff.length} />

              <section class="flex flex-col gap-5">
                <div>
                  <p class="text-xs font-semibold tracking-wide uppercase text-(--accent)">Editing {weekLabel(selectedWeek).toLowerCase()}</p>
                  <h2 class={sectionTitle}>Week of {formatLong(selectedWeek)}</h2>
                </div>
                <div class="flex max-w-3xl flex-col gap-1.5">
                  <label for="notes" class="text-sm font-semibold text-(--text-strong)">
                    Notes for the week <span class="font-normal text-(--text-muted)">(optional)</span>
                  </label>
                  <textarea id="notes" name="notes" rows="3" maxlength={LIMITS.notes} class={inputClass}>{edit.notes}</textarea>
                </div>
              </section>

              <section class="flex flex-col gap-4">
                <div>
                  <h3 class="text-lg font-bold text-(--text-strong)">Shifts</h3>
                  <p class="mt-1 text-sm text-(--text-muted)">
                    Choose <strong class="font-semibold text-(--text-body)">Set hours</strong> on a row,
                    or click any day, to pick a start time (end time optional) and the days it applies to. Names
                    and positions are shared by both weeks.
                  </p>
                </div>

                <div class="scroll-x rounded-(--radius-card) border border-(--border-subtle) bg-(--surface-raised)">
                  <table class="w-full min-w-[66rem] border-collapse text-sm">
                    <thead class="border-b border-(--border-subtle) bg-(--surface-sunken)">
                      <tr>
                        <th scope="col" class={thClass}>Employee</th>
                        {DAYS.map((day) => {
                          const off = daysOffByDate.get(dates[day]);
                          return (
                            <th scope="col" class:list={['px-2 py-2.5 text-left align-bottom whitespace-nowrap', off && 'bg-(--accent-subtle-bg)']}>
                              <span class="block text-xs font-semibold tracking-wide uppercase text-(--text-muted)">{DAY_LABELS[day]}</span>
                              <span class="block text-sm font-semibold text-(--text-strong)">{formatShort(dates[day])}</span>
                              {off && <span class="block text-xs font-semibold text-(--accent-subtle-text)" title={off.name}>Day off</span>}
                            </th>
                          );
                        })}
                        <th scope="col" class={thClass}>Remove</th>
                      </tr>
                    </thead>
                    <tbody id="emp-rows">
                      {edit.employees.map((emp, i) => (
                        <EmployeeEditRow index={i} emp={emp} dates={dates} dayOffDates={dayOffDates} errorAt={errorAt} />
                      ))}
                      {edit.employees.length === 0 && (
                        <tr data-empty>
                          <td colspan={DAYS.length + 2} class="px-4 py-6 text-center text-sm text-(--text-muted)">
                            No one on the schedule yet. Use Add New Employee below.
                          </td>
                        </tr>
                      )}
                    </tbody>
                  </table>
                </div>
                <template id="emp-row-template">
                  <EmployeeEditRow dates={dates} dayOffDates={dayOffDates} />
                </template>
                <ShiftDialog dates={dates} dayOffDates={dayOffDates} />
                <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
                  <Button type="button" variant="secondary" data-add-row="emp">
                    <Icon name="plus" size={16} />
                    Add New Employee
                  </Button>
                  <p class="text-xs text-(--text-muted)">
                    Removing someone takes them off both weeks. Everyone with the staff password can
                    see this page, so keep it to names, positions and shifts.
                  </p>
                </div>
              </section>

              <section class="flex flex-col gap-4">
                <div>
                  <h3 class="text-lg font-bold text-(--text-strong)">Company days off</h3>
                  <p class="mt-1 text-sm text-(--text-muted)">
                    Days that apply to everyone, in any week. Staff only see upcoming ones; past
                    dates stay here until you remove them.
                  </p>
                </div>

                <div class="scroll-x rounded-(--radius-card) border border-(--border-subtle) bg-(--surface-raised)">
                  <table class="w-full min-w-[44rem] border-collapse text-sm">
                    <thead class="border-b border-(--border-subtle) bg-(--surface-sunken)">
                      <tr>
                        <th scope="col" class={thClass}>Date</th>
                        <th scope="col" class={thClass}>Name</th>
                        <th scope="col" class={thClass}>Note</th>
                        <th scope="col" class={thClass}>Remove</th>
                      </tr>
                    </thead>
                    <tbody id="off-rows">
                      {edit.daysOff.map((off, i) => (
                        <DayOffEditRow index={i} off={off} today={today} />
                      ))}
                      {edit.daysOff.length === 0 && (
                        <tr data-empty>
                          <td colspan="4" class="px-4 py-6 text-center text-sm text-(--text-muted)">
                            No company days off yet. Use Add New Company Holiday below.
                          </td>
                        </tr>
                      )}
                    </tbody>
                  </table>
                </div>
                <template id="off-row-template">
                  <DayOffEditRow today={today} />
                </template>
                <div>
                  <Button type="button" variant="secondary" data-add-row="off">
                    <Icon name="plus" size={16} />
                    Add New Company Holiday
                  </Button>
                </div>
              </section>

              <div class="sticky bottom-0 z-20 -mx-5 flex flex-wrap items-center gap-3 border-t border-(--border-subtle) bg-(--surface-page)/90 px-5 py-4 backdrop-blur-md sm:-mx-8 sm:px-8">
                <Button type="submit">
                  <Icon name="check" size={16} />
                  Save {weekLabel(selectedWeek).toLowerCase()}
                </Button>
                <Button href={weekUrl(selectedWeek)} variant="ghost">Cancel</Button>
              </div>
            </form>
          ) : (
            /* ================================================================
               VIEW MODE
               ================================================================ */
            <>
              <section class="flex flex-col gap-5">
                <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
                  <div class="flex flex-col gap-3">
                    <h2 class={sectionTitle}>Weekly schedule</h2>
                    <nav aria-label="Choose week" class="inline-flex w-fit gap-1 rounded-full border border-(--border-subtle) bg-(--surface-sunken) p-1">
                      {[CURRENT_WEEK, NEXT_WEEK].map((w) => (
                        <a
                          href={weekUrl(w)}
                          aria-current={w === selectedWeek ? 'page' : undefined}
                          class:list={[
                            'rounded-full px-4 py-1.5 text-sm font-semibold whitespace-nowrap transition-colors',
                            w === selectedWeek
                              ? 'bg-(--surface-raised) text-(--text-strong) shadow-(--shadow-card)'
                              : 'text-(--text-muted) hover:text-(--text-strong)',
                          ]}
                        >
                          {weekLabel(w)}
                          <span class="ml-1 font-normal text-(--text-muted)">{formatShort(w)}</span>
                        </a>
                      ))}
                    </nav>
                    <p class="text-sm font-medium text-(--text-body)">
                      {formatShort(dates.mon)} – {formatShort(dates.sun)}
                    </p>
                  </div>

                  {isEditor && (
                    <Button href={weekUrl(selectedWeek, '&edit=1')} class="w-fit">
                      Edit {weekLabel(selectedWeek).toLowerCase()}
                    </Button>
                  )}
                </div>

                {isEditor && schedule.employees.length > 0 && (
                  <div class="flex flex-col gap-3 rounded-(--radius-card) border border-dashed border-(--border-strong) p-4 sm:flex-row sm:flex-wrap sm:items-center">
                    <span class="text-xs font-semibold tracking-wide uppercase text-(--text-muted)">Copy shifts</span>
                    {copyActions.map((action) => (
                      <form method="POST" action={weekUrl(selectedWeek)} data-confirm={action.confirm || undefined}>
                        <input type="hidden" name="intent" value="copy" />
                        <input type="hidden" name="from" value={action.from} />
                        <input type="hidden" name="to" value={action.to} />
                        <input type="hidden" name="basedOn" value={schedule.updatedAt ?? ''} />
                        <Button type="submit" variant="secondary">
                          {action.label}
                          <Icon name="arrow-right" size={16} />
                        </Button>
                      </form>
                    ))}
                    <p class="text-xs text-(--text-muted) sm:basis-full">
                      Copying replaces the other week's shifts. Each week keeps its own notes.
                    </p>
                  </div>
                )}

                {week.notes && (
                  <div class="rounded-(--radius-card) border-l-4 border-(--accent) bg-(--surface-sunken) p-5">
                    <p class="text-xs font-semibold tracking-wide uppercase text-(--text-muted)">Notes</p>
                    <p class="mt-1.5 text-sm leading-relaxed whitespace-pre-line text-(--text-body)">{week.notes}</p>
                  </div>
                )}

                {/*
                  Staff see the table only once shifts are posted: a roster of
                  people all marked "Off" would read as a real answer. Editors
                  always see the roster, with a note while the week is empty.
                */}
                {isEditor && schedule.employees.length > 0 && !hasShifts && (
                  <p class="rounded-lg bg-(--surface-sunken) px-4 py-3 text-sm text-(--text-body)">
                    No shifts entered for {weekLabel(selectedWeek).toLowerCase()} yet, so staff see
                    &ldquo;not posted yet&rdquo; for this week. Edit the week to add times, or copy
                    them from the other week.
                  </p>
                )}

                {schedule.employees.length === 0 || (!hasShifts && !isEditor) ? (
                  <div class="rounded-(--radius-card) border border-dashed border-(--border-strong) bg-(--surface-sunken) p-8 text-center">
                    <Icon name="clock" size={24} class="mx-auto text-(--text-muted)" />
                    <p class="mt-3 font-semibold text-(--text-strong)">
                      {weekLabel(selectedWeek)}&rsquo;s schedule hasn&rsquo;t been posted yet
                    </p>
                    <p class="mt-1 text-sm text-(--text-muted)">
                      {isEditor
                        ? 'Edit this week to add employees and their shifts.'
                        : 'Check back soon, or call dispatch to confirm your shift.'}
                    </p>
                  </div>
                ) : (
                  <div class="scroll-x rounded-(--radius-card) border border-(--border-subtle) bg-(--surface-raised) shadow-(--shadow-card)">
                    <table class="w-full min-w-[60rem] border-collapse text-sm">
                      <caption class="sr-only">Staff schedule for the week of {formatLong(selectedWeek)}</caption>
                      <thead class="border-b border-(--border-subtle) bg-(--surface-sunken)">
                        <tr>
                          <th scope="col" class:list={[thClass, 'sticky left-0 z-10 bg-(--surface-sunken)']}>Employee</th>
                          {DAYS.map((day) => {
                            const date = dates[day];
                            const off = daysOffByDate.get(date);
                            return (
                              <th
                                scope="col"
                                class:list={['px-3 py-2.5 text-left align-bottom whitespace-nowrap', off && 'bg-(--accent-subtle-bg)']}
                              >
                                <span class:list={['block text-xs font-semibold tracking-wide uppercase', date === today ? 'text-(--accent)' : 'text-(--text-muted)']}>
                                  {DAY_LABELS[day]}
                                  {date === today && <span class="ml-1 normal-case tracking-normal">· Today</span>}
                                </span>
                                <span class="block text-sm font-semibold text-(--text-strong)">{formatShort(date)}</span>
                                {off && (
                                  <span class="mt-0.5 block text-xs font-semibold text-(--accent-subtle-text)" title={off.name}>
                                    Company day off
                                  </span>
                                )}
                              </th>
                            );
                          })}
                        </tr>
                      </thead>
                      <tbody>
                        {schedule.employees.map((emp) => {
                          const shifts = week.shifts[emp.id];
                          return (
                            <tr class="border-b border-(--border-subtle) last:border-b-0 hover:bg-(--surface-sunken)/60">
                              <th scope="row" class="sticky left-0 z-10 min-w-40 bg-(--surface-raised) px-3 py-3 text-left font-normal">
                                <span class="block font-semibold text-(--text-strong)">{emp.name}</span>
                                {emp.role && <span class="block text-xs text-(--text-muted)">{emp.role}</span>}
                              </th>
                              {DAYS.map((day) => {
                                const shift = shifts?.[day];
                                return (
                                  <td class:list={['px-3 py-3 whitespace-nowrap tabular-nums', daysOffByDate.has(dates[day]) && 'bg-(--accent-subtle-bg)/60']}>
                                    {shift ? (
                                      <span class="font-medium text-(--text-strong)">{formatShift(shift)}</span>
                                    ) : hasShifts ? (
                                      <span class="text-(--text-muted)">Off</span>
                                    ) : (
                                      <span class="text-(--text-muted)" aria-label="Not entered">—</span>
                                    )}
                                  </td>
                                );
                              })}
                            </tr>
                          );
                        })}
                      </tbody>
                    </table>
                  </div>
                )}
              </section>

              <section class="flex flex-col gap-5">
                <h2 class={sectionTitle}>Company days off</h2>

                {upcomingDaysOff.length === 0 ? (
                  <p class="text-sm text-(--text-muted)">No upcoming company days off.</p>
                ) : (
                  <div class="scroll-x rounded-(--radius-card) border border-(--border-subtle) bg-(--surface-raised) shadow-(--shadow-card)">
                    <table class="w-full min-w-[32rem] border-collapse text-sm">
                      <caption class="sr-only">Upcoming company days off</caption>
                      <thead class="border-b border-(--border-subtle) bg-(--surface-sunken)">
                        <tr>
                          <th scope="col" class={thClass}>Date</th>
                          <th scope="col" class={thClass}>Day off</th>
                          <th scope="col" class={thClass}>Note</th>
                        </tr>
                      </thead>
                      <tbody>
                        {upcomingDaysOff.map((off) => (
                          <tr class="border-b border-(--border-subtle) last:border-b-0">
                            <td class="px-3 py-3 whitespace-nowrap">
                              <span class="font-semibold text-(--text-strong)">{formatLong(off.date)}</span>
                              {off.date === today ? (
                                <span class="ml-2 rounded-full bg-(--accent) px-2 py-0.5 text-[0.65rem] font-semibold uppercase text-(--accent-on)">Today</span>
                              ) : currentWeekDates.includes(off.date) ? (
                                <span class="ml-2 rounded-full bg-(--accent-subtle-bg) px-2 py-0.5 text-[0.65rem] font-semibold uppercase text-(--accent-subtle-text)">This week</span>
                              ) : nextWeekDates.includes(off.date) ? (
                                <span class="ml-2 rounded-full bg-(--surface-sunken) px-2 py-0.5 text-[0.65rem] font-semibold uppercase text-(--text-muted)">Next week</span>
                              ) : null}
                            </td>
                            <td class="px-3 py-3 font-medium text-(--text-strong)">{off.name}</td>
                            <td class="px-3 py-3 text-(--text-body)">{off.note || <span class="text-(--text-muted)">—</span>}</td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                )}
              </section>

              {!isEditor && editingEnabled && (
                <p class="text-sm text-(--text-muted)">
                  Maintain the schedule? Sign out, then sign in with the editor password.
                </p>
              )}
            </>
          )}
        </div>
      ) : (
        <div class="max-w-md">
          <div class="flex flex-col gap-5 rounded-(--radius-card) border border-(--border-subtle) bg-(--surface-raised) p-6 shadow-(--shadow-card) sm:p-8">
            <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-(--accent-subtle-bg) text-(--accent-subtle-text)">
              <Icon name="lock" size={22} />
            </span>

            <div>
              <h2 class="text-xl font-bold text-(--text-strong)">Password required</h2>
              <p class="mt-2 text-sm leading-relaxed text-(--text-body)">
                Enter the staff password to see this week's schedule. Schedule editors sign in here
                with their own password.
              </p>
            </div>

            <form method="POST" action={PAGE} class="flex flex-col gap-4">
              <input type="hidden" name="intent" value="login" />
              <div class="flex flex-col gap-1.5">
                <label for="password" class="text-sm font-semibold text-(--text-strong)">
                  Password
                </label>
                <input
                  type="password"
                  id="password"
                  name="password"
                  required
                  autocomplete="current-password"
                  aria-describedby={error ? 'password-error' : undefined}
                  aria-invalid={error ? 'true' : undefined}
                  class="rounded-xl border border-(--border-strong) bg-(--surface-page) px-4 py-2.5 text-(--text-strong) placeholder:text-(--text-muted)"
                />
                {error && (
                  <p id="password-error" role="alert" class="mt-1 text-sm font-medium text-red-600 dark:text-red-400">
                    {error}
                  </p>
                )}
              </div>

              <Button type="submit">Enter</Button>
            </form>
          </div>

          <p class="mt-5 text-sm text-(--text-muted)">
            Need the password? <a href="/contact/" class="font-semibold text-(--accent) underline-offset-4 hover:underline">Contact us</a>.
          </p>
        </div>
      )
    }
  </Container>
</PageLayout>

<script>
  import { ROW_INDEX, ROW_NUMBER } from '../components/schedule/classes';
  import { formatShift } from '../lib/time';

  /*
   * Everything here is editor convenience. The server validates every save
   * regardless, so nothing below is a security boundary.
   */

  /* ------------------------------------------------------------------------ */
  /* Set hours dialog                                                          */
  /* ------------------------------------------------------------------------ */

  /*
   * One dialog serves every row. It is opened from a row's "Set hours" button
   * or from a day cell, and writes the chosen times into that row's hidden
   * `emp-N-day-start` / `-end` inputs — the same fields the server has always
   * read — then refreshes the cell labels.
   */
  const dialog = document.getElementById('shift-dialog') as HTMLDialogElement | null;

  if (dialog) {
    const $ = <T extends Element>(selector: string) => dialog.querySelector<T>(selector) as T;
    const startInput = $<HTMLInputElement>('[data-dialog-start]');
    const endInput = $<HTMLInputElement>('[data-dialog-end]');
    const nameEl = $<HTMLElement>('[data-dialog-name]');
    const errorEl = $<HTMLElement>('[data-dialog-error]');
    const presetsEl = $<HTMLElement>('[data-dialog-presets]');
    const dayBoxes = [...dialog.querySelectorAll<HTMLInputElement>('[data-dialog-day]')];
    const allDays = dayBoxes.map((box) => box.value);

    const DAY_SETS: Record<string, string[]> = {
      weekdays: allDays.slice(0, 5),
      weekend: allDays.slice(5),
      all: allDays,
      none: [],
    };

    let row: HTMLElement | null = null;
    let returnFocus: HTMLElement | null = null;

    const cellFor = (r: HTMLElement, day: string) => r.querySelector<HTMLElement>(`[data-day-cell="${day}"]`)!;
    const readCell = (cell: HTMLElement) => ({
      start: cell.querySelector<HTMLInputElement>('[data-start]')!.value,
      end: cell.querySelector<HTMLInputElement>('[data-end]')!.value,
    });
    // A start time makes a shift; the end time is optional.
    const isShift = (t: { start: string; end: string }) => Boolean(t.start);

    const showError = (message: string) => {
      errorEl.textContent = message;
      errorEl.hidden = !message;
    };

    function writeCell(cell: HTMLElement, start: string, end: string) {
      cell.querySelector<HTMLInputElement>('[data-start]')!.value = start;
      cell.querySelector<HTMLInputElement>('[data-end]')!.value = end;

      const button = cell.querySelector<HTMLButtonElement>('[data-edit-day]')!;
      const text = start ? formatShift({ start, end }) : 'Off';
      const who = row?.querySelector<HTMLInputElement>('[data-emp-name]')?.value || 'New employee';
      button.textContent = text;
      button.dataset.set = String(Boolean(start));
      button.removeAttribute('aria-invalid');
      button.setAttribute('aria-label', `${who}, ${cell.dataset.dayCell}: ${text}. Change hours`);
      cell.querySelector('[data-cell-error]')?.remove();
    }

    /** Distinct shifts already used anywhere in this week, as one-click presets. */
    function renderPresets() {
      presetsEl.querySelectorAll('[data-preset]').forEach((el) => el.remove());
      const seen = new Map<string, { start: string; end: string }>();
      document.querySelectorAll<HTMLElement>('[data-day-cell]').forEach((cell) => {
        const t = readCell(cell);
        if (isShift(t) && (!t.end || t.start < t.end)) seen.set(`${t.start}-${t.end}`, t);
      });

      const presets = [...seen.values()].sort((a, b) => a.start.localeCompare(b.start)).slice(0, 8);
      for (const t of presets) {
        const chip = document.createElement('button');
        chip.type = 'button';
        chip.dataset.preset = '';
        chip.className =
          'rounded-full border border-(--border-strong) px-3 py-1 text-xs font-semibold tabular-nums text-(--text-body) hover:border-(--accent) hover:text-(--accent)';
        chip.textContent = formatShift(t);
        chip.addEventListener('click', () => {
          startInput.value = t.start;
          endInput.value = t.end;
          showError('');
        });
        presetsEl.append(chip);
      }
      presetsEl.hidden = presets.length === 0;
    }

    function openFor(targetRow: HTMLElement, day: string | null, trigger: HTMLElement) {
      row = targetRow;
      returnFocus = trigger;
      nameEl.textContent = row.querySelector<HTMLInputElement>('[data-emp-name]')?.value || 'New employee';

      // From a day cell: that day and its times. From "Set hours": the row's
      // first shift, with every day already on those exact hours ticked, so
      // changing a regular pattern is one edit.
      const seed = day
        ? readCell(cellFor(row, day))
        : allDays.map((d) => readCell(cellFor(targetRow, d))).find(isShift) ?? { start: '', end: '' };

      startInput.value = seed.start;
      endInput.value = seed.end;
      for (const box of dayBoxes) {
        const t = readCell(cellFor(row, box.value));
        box.checked = day ? box.value === day : isShift(seed) && t.start === seed.start && t.end === seed.end;
      }

      showError('');
      renderPresets();
      dialog!.showModal();
      startInput.focus();
    }

    const selectedDays = () => dayBoxes.filter((box) => box.checked).map((box) => box.value);

    function close() {
      dialog!.close();
    }

    dialog.addEventListener('close', () => {
      returnFocus?.focus();
      row = null;
    });

    // Any change to the times or days makes the last complaint stale.
    dialog.addEventListener('input', () => showError(''));

    // A click on the backdrop lands on the <dialog> element itself.
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) close();
    });
    dialog.querySelectorAll('[data-dialog-close]').forEach((el) => el.addEventListener('click', close));

    dialog.querySelectorAll<HTMLButtonElement>('[data-select-days]').forEach((button) =>
      button.addEventListener('click', () => {
        const set = DAY_SETS[button.dataset.selectDays ?? ''] ?? [];
        dayBoxes.forEach((box) => (box.checked = set.includes(box.value)));
        showError('');
      })
    );

    $<HTMLButtonElement>('[data-dialog-apply]').addEventListener('click', () => {
      const start = startInput.value;
      const end = endInput.value;
      const days = selectedDays();

      if (!start) return showError('Choose a start time.');
      // The end time is optional. `HH:MM` strings compare correctly as text.
      if (end && start >= end) return showError('The start time must be earlier than the end time.');
      if (!days.length) return showError('Choose at least one day.');

      days.forEach((d) => writeCell(cellFor(row!, d), start, end));
      close();
    });

    $<HTMLButtonElement>('[data-dialog-off]').addEventListener('click', () => {
      const days = selectedDays();
      if (!days.length) return showError('Choose at least one day to mark off.');
      days.forEach((d) => writeCell(cellFor(row!, d), '', ''));
      close();
    });

    // Delegated, so rows added with "Add New Employee" work too.
    document.addEventListener('click', (event) => {
      const target = event.target as Element;
      const trigger = target.closest?.<HTMLElement>('[data-set-hours], [data-edit-day]');
      const targetRow = trigger?.closest<HTMLElement>('[data-emp-row]');
      if (!trigger || !targetRow) return;
      openFor(targetRow, trigger.dataset.editDay ?? null, trigger);
    });
  }

  /* ------------------------------------------------------------------------ */
  /* Adding and discarding rows                                                */
  /* ------------------------------------------------------------------------ */

  /*
   * "Add New Employee" / "Add New Company Holiday": clone the row <template>,
   * give it the next free index, and bump the count the server reads up to.
   */
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-add-row]')) {
    const kind = button.dataset.addRow;
    const template = document.getElementById(`${kind}-row-template`) as HTMLTemplateElement | null;
    const body = document.getElementById(`${kind}-rows`);
    const counter = document.querySelector<HTMLInputElement>(`input[name="${kind}-count"]`);
    if (!template || !body || !counter) continue;

    button.addEventListener('click', () => {
      const index = Number(counter.value) || 0;
      const html = template.innerHTML
        .replaceAll(ROW_INDEX, String(index))
        .replaceAll(ROW_NUMBER, String(index + 1));

      body.querySelector('[data-empty]')?.remove();
      body.insertAdjacentHTML('beforeend', html);
      counter.value = String(index + 1);
      body.lastElementChild?.querySelector<HTMLInputElement>('input:not([type="hidden"])')?.focus();
    });
  }

  /* A row added in this session and not yet saved can simply be discarded. */
  document.addEventListener('click', (event) => {
    const button = (event.target as Element).closest?.('[data-remove-row]');
    button?.closest('tr')?.remove();
  });

  /* Copying over a week that already has shifts asks first. */
  for (const form of document.querySelectorAll<HTMLFormElement>('form[data-confirm]')) {
    form.addEventListener('submit', (event) => {
      if (!window.confirm(form.dataset.confirm ?? '')) event.preventDefault();
    });
  }
</script>
