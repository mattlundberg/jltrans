---
import PageLayout from '../layouts/PageLayout.astro';
import Container from '../components/primitives/Container.astro';
import SectionHeading from '../components/primitives/SectionHeading.astro';
import FormCard from '../components/cards/FormCard.astro';
import PdfCard from '../components/cards/PdfCard.astro';
import Icon from '../components/primitives/Icon.astro';
import Button from '../components/primitives/Button.astro';
import { applicationForms, documents, site } from '../data/site';
import { telHref } from '../lib/format';

const customerForms = applicationForms.filter((f) => f.audience === 'customers');
const employmentForms = applicationForms.filter((f) => f.audience !== 'customers');

/**
 * The "Documents and certificates" section is hidden until the client supplies
 * current versions of the PDFs. Flip this back to `true` to show it again.
 */
const SHOW_DOCUMENTS = false;
---

<PageLayout
  title="Forms & Documents"
  kicker="Forms"
  description="Complete the J & L Transportation forms you need — credit application, driver and mechanic applications."
  lead="Complete the forms you need."
>
  <Container class="py-section">
    <div class="flex flex-col gap-16">
      <p class="flex max-w-3xl items-start gap-3 rounded-(--radius-card) border border-(--border-subtle) bg-(--surface-sunken) p-5 text-sm leading-relaxed text-(--text-body)">
        <Icon name="download" size={20} class="mt-0.5 shrink-0 text-(--accent)" />
        <span>
          Each form is a fillable PDF. Download it, fill it in on your computer (or print it and
          fill it in by hand), sign it, and return it to our office.
        </span>
      </p>

      <section>
        <SectionHeading as="h2" kicker="For customers" title="Open an account" />
        <ul class="mt-8 grid gap-6 sm:grid-cols-2">
          {
            customerForms.map((form) => (
              <FormCard
                title={form.title}
                description={form.description}
                href={form.href}
                pages={form.pages}
                audience={form.audience}
              />
            ))
          }
        </ul>
      </section>

      <section>
        <SectionHeading as="h2" kicker="Join us" title="Driver and mechanic applications">
          <p>
            Applying to drive for J&amp;L, or to work as a mechanic in our shop? Start here.
          </p>
        </SectionHeading>
        <ul class="mt-8 grid gap-6 sm:grid-cols-2">
          {
            employmentForms.map((form) => (
              <FormCard
                title={form.title}
                description={form.description}
                href={form.href}
                pages={form.pages}
                audience={form.audience}
              />
            ))
          }
        </ul>
      </section>

      {
        SHOW_DOCUMENTS && (
          <section>
            <SectionHeading as="h2" kicker="Reference" title="Documents and certificates">
              <p>
                Download any of these directly. Every file is served over HTTPS from our own site.
              </p>
            </SectionHeading>
            <ul class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
              {documents.map((doc) => (
                <PdfCard
                  title={doc.title}
                  description={doc.description}
                  file={doc.file}
                  stale={'stale' in doc ? doc.stale : false}
                />
              ))}
            </ul>
          </section>
        )
      }

      <aside
        class="flex flex-col gap-4 rounded-(--radius-card) border border-(--border-subtle) bg-(--surface-sunken) p-6 sm:flex-row sm:items-center sm:justify-between sm:p-8"
      >
        <div class="flex gap-4">
          <Icon name="phone" size={22} class="mt-1 text-(--accent)" />
          <div>
            <h2 class="font-bold text-(--text-strong)">Need a form we don't list?</h2>
            <p class="mt-1 text-sm leading-relaxed text-(--text-body)">
              Call us and we will email or fax it straight to you.
            </p>
          </div>
        </div>
        <Button href={`tel:${telHref(site.phone)}`} class="shrink-0">
          <Icon name="phone" size={16} />
          {site.phone}
        </Button>
      </aside>
    </div>
  </Container>
</PageLayout>
