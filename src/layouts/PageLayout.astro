---
import BaseLayout from './BaseLayout.astro';
import Container from '../components/primitives/Container.astro';
import SectionHeading from '../components/primitives/SectionHeading.astro';
import HeroBackdrop from '../components/blocks/HeroBackdrop.astro';

/**
 * Inner-page shell: breadcrumb, page <h1>, and optional lead paragraph, on the
 * same dark backdrop as the home hero. Home does not use this — it has its own
 * hero.
 */
interface Props {
  title: string;
  description: string;
  /** Small label above the h1. Defaults to nothing. */
  kicker?: string;
  /** Lead paragraph under the h1. Falls back to `description`. */
  lead?: string;
  noindex?: boolean;
}

const { title, description, kicker, lead, noindex = false } = Astro.props;
---

<BaseLayout {title} {description} {noindex}>
  <slot name="head" slot="head" />

  <div class="relative isolate overflow-hidden border-b border-white/10 bg-(--color-ink-900) text-white">
    <HeroBackdrop />

    <Container class="py-4">
      <nav aria-label="Breadcrumb">
        <ol class="flex flex-wrap items-center gap-2 text-sm text-(--color-ink-200)">
          <li>
            <a href="/" class="underline-offset-4 hover:text-(--color-brand-400) hover:underline">Home</a>
          </li>
          <li aria-hidden="true">/</li>
          <li class="font-medium text-white" aria-current="page">{title}</li>
        </ol>
      </nav>
    </Container>

    <Container class="pt-6 pb-14 sm:pb-20">
      <SectionHeading as="h1" size="hero" tone="inverse" {kicker} {title}>
        {lead ?? description}
      </SectionHeading>
    </Container>
  </div>

  <slot />
</BaseLayout>
