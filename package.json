{
  "name": "jltrans",
  "version": "1.0.0",
  "private": true,
  "description": "J & L Transportation, Inc. — marketing site",
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "prebuild": "node scripts/scan-spam.mjs src public",
    "build": "astro build",
    "postbuild": "node scripts/scan-spam.mjs dist",
    "build:launch": "node scripts/scan-spam.mjs --strict src public && astro build && node scripts/scan-spam.mjs --strict dist",
    "preview": "netlify dev",
    "check": "astro check",
    "scan": "node scripts/scan-spam.mjs src public dist",
    "todos": "node scripts/scan-spam.mjs --todos-only src",
    "verify": "npm run check && npm run build"
  },
  "dependencies": {
    "@astrojs/netlify": "8.1.3",
    "@astrojs/sitemap": "3.7.3",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.1.3",
    "sharp": "0.35.3",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@types/node": "24.13.3",
    "typescript": "6.0.3"
  }
}
