{
  // Cloudflare Workers configuration.
  //
  // NOTE: this is a Workers project, not Cloudflare Pages. @astrojs/cloudflare
  // v14 dropped Pages support ("you should migrate to Cloudflare Workers"), and
  // a Pages-style `pages_build_output_dir` here makes the build fail — Pages
  // reserves the ASSETS binding name that the adapter needs.
  //
  // Do NOT add an `assets` block: Astro generates it.
  //
  // Secrets are never stored here. Set them once for production with:
  //   npx wrangler secret put DO_I_WORK_PASSWORD
  //   npx wrangler secret put AUTH_SECRET
  // For local development, copy .dev.vars.example to .dev.vars (gitignored).
  "name": "jltrans",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-07-24",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  }
}
